# Resend: use a sender on a domain verified in Resend.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL="YOUMEGA Website <website@iyomega.com>"
INQUIRY_TO_EMAIL="Ceciya@xmmega.com"

# Airtable personal access token with data.records:read and data.records:write.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=app1kcgOwrIxM7bip
AIRTABLE_TABLE_ID=tblHpJwa0UxSey3rA

# Enterprise WeChat group robot webhook. Keep the complete URL secret.
WECOM_WEBHOOK_URL=

# Admin token for /admin and the product CRUD API (x-admin-token header).
# Generate a long random string; without it all write endpoints return 503.
ADMIN_TOKEN=

# Product storage: an Airtable table named "Products" in the same base.
# Field spec: see ADMIN.md. Only needed for /admin and dynamic product pages.
AIRTABLE_PRODUCTS_TABLE=Products
